<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:luaShipyard="clr-namespace:Content.Client._Lua.Shipyard.UI"
                      SetSize="860 580"
                      MinSize="760 500">
    <BoxContainer Orientation="Vertical" Margin="6">
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 6">
            <Button Name="TargetIdButton" Access="Public" />
            <controls:ConfirmButton Name="ParkButton"
                                    Access="Public"
                                    Text="{Loc 'shipyard-console-park'}"
                                    ConfirmationText="{Loc 'admin-notes-delete-confirm'}"
                                    Margin="6 0 0 0"
                                    Disabled="True" />
            <controls:ConfirmButton Name="RecallButton"
                                    Access="Public"
                                    Text="{Loc 'shipyard-console-recall'}"
                                    ConfirmationText="{Loc 'admin-notes-delete-confirm'}"
                                    Margin="6 0 0 0"
                                    Disabled="True" />
            <Button Name="ExtendParkingButton"
                    Access="Public"
                    Text="{Loc 'shipyard-console-parking-extend'}"
                    Margin="6 0 0 0"
                    Disabled="True" />
        </BoxContainer>

        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True"
                      Margin="0 0 0 6">
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" Name="NoDeedHelperContainer" Visible="True">
                    <Label Text="{Loc 'shipyard-console-no-idcard-helper-line1'}" />
                    <Label Text="{Loc 'shipyard-console-no-idcard-helper-line2'}" />
                </BoxContainer>

                <BoxContainer Orientation="Vertical" Name="DeedContainer" Visible="False">
                    <Label Text="{Loc 'shipyard-console-deed-label'}" />
                    <Label Name="DeedTitle" Text="" />
                    <Label Name="ParkingStatus" Text="" Margin="0 4 0 0" />
                    <Label Name="ParkingCooldown" Text="" Margin="0 4 0 0" />
                </BoxContainer>
            </BoxContainer>

            <BoxContainer Orientation="Vertical"
                          Name="ParkingInfoContainer"
                          Margin="18 0 0 0"
                          MinSize="360 0">
                <BoxContainer Orientation="Horizontal">
                    <Label Text="{Loc 'bank-atm-menu-balance-label'}" FontColorOverride="Silver" />
                    <Label Name="BalanceLabel" Text="{Loc 'shipyard-console-no-bank'}" />
                    <Label Name="ParkingPrice" Text="" Margin="18 0 0 0" />
                </BoxContainer>
                <Label Name="ParkingRemaining" Text="" Margin="0 4 0 0" />
            </BoxContainer>
        </BoxContainer>

        <luaShipyard:ShipyardDockRadarControl Name="DockRadar"
                                              HorizontalExpand="True"
                                              VerticalExpand="True"
                                              MinSize="340 360" />
    </BoxContainer>
</controls:FancyWindow>
